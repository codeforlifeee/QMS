# ============================================================
# GOOGLE SHEETS API CONFIGURATION
# ============================================================
# Get your API key from: https://console.cloud.google.com/
# Make sure to:
# 1. Enable Google Sheets API
# 2. Create an API Key (not OAuth)
# 3. Restrict it to Sheets API only (for security)
# 4. Make your Google Sheet publicly readable (Share > Anyone with the link > View access)

VITE_GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here

# ============================================================
# GOOGLE SHEET DOCUMENT
# ============================================================
# Your Sheet URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
# Extract the Sheet ID from the URL and paste it below
VITE_SHEET_ID=1gEu2lwx835VciZOGC6DZNTpbWkvp9EYM

# ============================================================
# SHEET STRUCTURE REQUIREMENTS
# ============================================================
# The sheet named "Rayna_cost" should have these columns:
# A: Location (e.g., Dubai, Paris, London)
# B: Category (e.g., Activities, Tours, Attractions)
# C: Tour (e.g., Desert Safari, City Tour)
# D: Product (specific product/variant name)
# E: Transfer (e.g., With Transfer, Without Transfer)
# F: Cost AED (price in AED)
# G: Cost USD (price in USD)
#
# Optional: Change sheet range if your data is in a different tab
# VITE_SHEET_RANGE=Rayna_cost!A:G

# ============================================================
# AI CONFIGURATION (Phase 1)
# ============================================================
# Choose from: claude | groq | gemini
AI_PROVIDER=groq

# API Keys
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
