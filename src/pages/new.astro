---
import { getRepo, newId, newToken } from '../data/repo.js';
import { DEFAULT_PAYMENT_POLICY, DEFAULT_TERMS } from '../config/company.js';
import { loadDefaults } from '../catalog/catalog.js';
import type { StoredQuotation } from '../data/schema.js';

export const prerender = false;

const repo = await getRepo();
const url = Astro.url;

// Pre-fill from lead data via query params
const clientName = url.searchParams.get('client_name') || '';
const clientPhone = url.searchParams.get('client_phone') || '';
const clientEmail = url.searchParams.get('client_email') || '';
const destination = url.searchParams.get('destination') || '';
const adults = parseInt(url.searchParams.get('adults') || '2', 10);
const children = parseInt(url.searchParams.get('children') || '0', 10);
const nights = parseInt(url.searchParams.get('nights') || '0', 10);
const travelDate = url.searchParams.get('travel_date') || '';
const leadId = url.searchParams.get('lead_id') || undefined;

const id = newId();
const now = new Date().toISOString();
const today = now.slice(0, 10);

// Use travel_date from lead if provided, otherwise default
const startDate = travelDate || new Date(Date.now() + 30 * 86_400_000).toISOString().slice(0, 10);
const endDate = nights > 0
  ? new Date(new Date(startDate).getTime() + nights * 86_400_000).toISOString().slice(0, 10)
  : new Date(new Date(startDate).getTime() + 15 * 86_400_000).toISOString().slice(0, 10);
const validUntil = new Date(Date.now() + 30 * 86_400_000).toISOString().slice(0, 10);

const yr = today.slice(0, 4);
const count = (await repo.list()).length + 1;
const reference = `TG-${yr}-${String(count).padStart(4, '0')}`;

const catalogDefaults = await loadDefaults();
const aedToInr = catalogDefaults ? catalogDefaults.fxAedPerInr.toFixed(2) : '22.85';
const houseMarkup = catalogDefaults ? Math.round(catalogDefaults.markupPct * 100) : 15;

// Generate days based on nights
const dayCount = nights > 0 ? nights + 1 : 2;
const days = Array.from({ length: dayCount }, (_, i) => ({
  id: `d${i + 1}`,
  index: i + 1,
  title: `Day ${i + 1}`,
  prose: '',
}));

const draft: StoredQuotation = {
  id,
  token: newToken(),
  status: 'draft',
  reference,
  ...(leadId ? { lead_id: leadId } : {}),
  title: destination ? `${destination} Trip` : 'New quotation',
  destination: destination || '',
  client: {
    name: clientName,
    ...(clientPhone ? { phone: clientPhone } : {}),
    ...(clientEmail ? { email: clientEmail } : {}),
  },
  travelStart: startDate,
  travelEnd: endDate,
  pax: { adults, children, infants: 0 },
  quoteCurrency: 'INR',
  fx: { AED: aedToInr },
  pricingMode: 'PER_SERVICE',
  defaultMarkupByType: {
    HOTEL: houseMarkup,
    ACTIVITY: houseMarkup,
    TRANSFER: houseMarkup,
    VISA: houseMarkup,
    MEAL: houseMarkup,
    MISC: houseMarkup,
  },
  taxRatesByClass: { standard: 5 },
  defaultTaxClass: 'standard',
  taxLabel: 'GST @ 5%',
  roundingUnit: 100,
  days,
  lines: [],
  paymentPolicy: [...DEFAULT_PAYMENT_POLICY],
  terms: [...DEFAULT_TERMS],
  createdAt: now,
  updatedAt: now,
  validUntil,
  viewCount: 0,
};

await repo.save(draft);
return Astro.redirect(`/edit/${id}`);
---
