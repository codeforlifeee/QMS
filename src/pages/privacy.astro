---
import Shell from '../layouts/Shell.astro';
import { COMPANY } from '../config/company.js';

export const prerender = false;
---

<Shell title="Privacy Policy" chrome={false}>
  <main class="min-h-screen bg-[color:var(--color-canvas)] py-10 px-4">
    <div class="mx-auto max-w-2xl">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--color-brand-orange)] hover:underline mb-6">
        ← Back
      </a>
      <article class="rounded-2xl border border-[color:var(--color-hairline)] bg-[color:var(--color-surface)] p-8 shadow-[var(--shadow-soft-sm)]">
        <header class="mb-6">
          <h1 class="font-heading text-3xl font-bold text-[color:var(--color-ink)]">Privacy Policy</h1>
          <p class="mt-2 text-sm text-[color:var(--color-muted-ink)]">Last updated: October 6, 2026 · {COMPANY.name}</p>
        </header>

        <section class="space-y-5 text-[color:var(--color-ink)] leading-relaxed">
          <div>
            <h2 class="font-heading text-lg font-semibold mb-1">1. Information collection</h2>
            <p class="text-sm text-[color:var(--color-muted-ink)]">
              We collect information you provide directly to us, such as when you submit a lead form
              via Facebook or any Traverse Globe inquiry channel. This includes your name, email
              address, and phone number.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-lg font-semibold mb-1">2. Use of information</h2>
            <p class="text-sm text-[color:var(--color-muted-ink)]">
              We use the information we collect to communicate with you about our travel services
              and packages, and to prepare and share quotations you request.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-lg font-semibold mb-1">3. Information sharing</h2>
            <p class="text-sm text-[color:var(--color-muted-ink)]">
              We do not share, sell, or rent your personal information to third parties.
            </p>
          </div>

          <div>
            <h2 class="font-heading text-lg font-semibold mb-1">4. Data deletion</h2>
            <p class="text-sm text-[color:var(--color-muted-ink)]">
              If you would like us to delete your data from our systems, please contact
              <a href={`mailto:${COMPANY.email}`} class="text-[color:var(--color-brand-orange)] font-semibold hover:underline">{COMPANY.email}</a>
              and we will process your request within 30 days.
            </p>
          </div>
        </section>

        <footer class="mt-8 pt-6 border-t border-[color:var(--color-hairline)] text-xs text-[color:var(--color-muted-ink)]">
          © {new Date().getFullYear()} {COMPANY.name}. All rights reserved.
        </footer>
      </article>
    </div>
  </main>
</Shell>
