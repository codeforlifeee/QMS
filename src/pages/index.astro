---
import Shell from '../layouts/Shell.astro';
import { getRepo } from '../data/repo.js';
import { toEngineInput, tripDuration } from '../data/schema.js';
import { priceQuotation } from '../pricing/engine.js';
import { formatMoney } from '../pricing/money.js';
import { DashboardView } from '../components/dashboard/DashboardView.tsx';

export const prerender = false;

const repo = await getRepo();
const quotations = await repo.list();
const recentQuotes = quotations.slice(0, 5);

let stats: Record<string, number> = {};
let totalLeads = 0;
let followUpCount = 0;
let recentLeadsRaw: any[] = [];
let allLeadsForSources: any[] = [];
let lastSync: { time: string; source: string } | null = null;

try {
  const fs = await import('node:fs/promises');
  const path = await import('node:path');
  const syncFile = path.resolve(process.cwd(), 'data', 'last_sync.json');
  const data = await fs.readFile(syncFile, 'utf8');
  lastSync = JSON.parse(data);
} catch {
  // no sync file yet
}

try {
  const { leadRepo } = await import('../data/leadRepo.js');
  const [s, leads, followUps] = await Promise.all([
    leadRepo.getStats(),
    leadRepo.list(),
    leadRepo.getFollowUpsDue(),
  ]);
  stats = s;
  totalLeads = Object.values(s).reduce((a, b) => a + b, 0);
  followUpCount = followUps.length;
  recentLeadsRaw = leads.slice(0, 6);
  allLeadsForSources = leads;
} catch {
  // Supabase not configured.
}

const quoteRows = recentQuotes.map((q: any) => {
  try {
    const r = priceQuotation(toEngineInput(q));
    const { nights } = tripDuration(q);
    return {
      id: q.id,
      title: q.title || 'Untitled',
      reference: q.reference,
      clientName: q.client?.name ?? '',
      nights,
      total: formatMoney(r.grandTotal, { showDecimals: false }),
    };
  } catch {
    return {
      id: q.id,
      title: q.title || 'Untitled',
      reference: q.reference,
      clientName: q.client?.name ?? '',
      nights: 0,
      total: '—',
    };
  }
});

const sourceCounts = new Map<string, number>();
for (const l of allLeadsForSources) {
  const label = (l.source || 'Direct').toString();
  sourceCounts.set(label, (sourceCounts.get(label) ?? 0) + 1);
}
const sources = [...sourceCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6)
  .map(([name, value]) => ({ name, value }));

const recentLeads = recentLeadsRaw.map((l: any) => ({
  id: l.id,
  customer_name: l.customer_name || 'Unknown',
  city: l.city,
  priority_bucket: l.priority_bucket || 'Untouched',
  updated_at: l.updated_at,
  created_at: l.created_at,
  source: l.source,
}));
---

<Shell title="Dashboard" width="wide">
  <DashboardView
    stats={stats}
    totalLeads={totalLeads}
    followUpCount={followUpCount}
    recentLeads={recentLeads}
    recentQuotes={quoteRows}
    totalQuotes={quotations.length}
    sources={sources}
    lastSync={lastSync}
    client:load
  />
</Shell>
