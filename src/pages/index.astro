---
import Shell from '../layouts/Shell.astro';
import { getRepo } from '../data/repo.js';
import { toEngineInput, tripDuration, paxSummary } from '../data/schema.js';
import { priceQuotation } from '../pricing/engine.js';
import { formatMoney } from '../pricing/money.js';
import AIGenerator from '../components/AIGenerator.tsx';
import PipelineView from '../crm/PipelineView.tsx';
import '../styles/crm.css';

export const prerender = false;

const repo = await getRepo();
const quotations = await repo.list();

const rows = quotations.map((q) => {
  try {
    const r = priceQuotation(toEngineInput(q));
    const { nights } = tripDuration(q);
    return {
      q,
      total: formatMoney(r.grandTotal, { showDecimals: false }),
      nights,
      ok: true,
    };
  } catch {
    return { q, total: '—', nights: 0, ok: false };
  }
});
---

<Shell title="Dashboard">
  <a slot="actions" href="/new" class="btn btn-primary">+ New Manual Quotation</a>

  <main class="list-wrap">
    <PipelineView client:load />

    <AIGenerator client:load />

    <div class="list-header">
      <h1>Quotations ({rows.length})</h1>
    </div>

    {
      rows.length === 0 ? (
        <div class="empty">
          <p>No quotations yet.</p>
          <p>
            <a href="/new" class="btn btn-primary">
              Create the first one
            </a>
          </p>
        </div>
      ) : (
        rows.map(({ q, total, nights, ok }) => (
          <article class="quotation-card">
            <div>
              <div class="title">{q.title || 'Untitled'}</div>
              <div class="meta">
                <span class={`pill ${q.status === 'draft' ? 'pill-draft' : ''}`}>{q.status}</span>
                &nbsp;&middot;&nbsp; {q.reference} &nbsp;&middot;&nbsp; {q.client.name} &nbsp;&middot;&nbsp;
                {paxSummary(q)}, {nights}N
                {q.lead_id && <span class="pill" style="margin-left:6px;background:#e0f2fe;color:#0369a1;">From Lead</span>}
              </div>
            </div>
            <div class="total">{total}</div>
            <div class="actions">
              <a href={`/edit/${q.id}`} class="btn btn-sm">
                Edit
              </a>
              {ok && (
                <>
                  <a href={`/q/${q.token}`} class="btn btn-sm">
                    Share
                  </a>
                  <a href={`/api/pdf/${q.token}`} class="btn btn-sm">
                    PDF
                  </a>
                </>
              )}
            </div>
          </article>
        ))
      )
    }
  </main>
</Shell>
