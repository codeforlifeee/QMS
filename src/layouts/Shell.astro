---
import '../styles/app.css';
import { COMPANY } from '../config/company.js';

interface Props {
  title?: string;
}
const { title = 'Quotations' } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — QMS</title>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-left">
        <div class="topbar-brand">
          <a href="/">QMS</a><small>{COMPANY.name}</small>
        </div>
        <nav class="topbar-nav">
          <a href="/" class:list={['topbar-nav-link', { active: path === '/' }]}>Dashboard</a>
          <a href="/leads" class:list={['topbar-nav-link', { active: path.startsWith('/leads') }]}>Leads</a>
          <a href="/quotations" class:list={['topbar-nav-link', { active: path.startsWith('/quotations') || path.startsWith('/edit') }]}>Quotations</a>
        </nav>
      </div>
      <div class="topbar-actions">
        <slot name="actions" />
      </div>
    </header>
    <slot />
  </body>
</html>
